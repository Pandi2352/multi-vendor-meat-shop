# ---------- App ----------
NODE_ENV=development
PORT=4000
APP_NAME=Meat Shop API
API_PREFIX=api
API_VERSION=1
# Comma-separated frontend origins: public storefront (3000), admin portal (3001)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
REQUEST_TIMEOUT_MS=15000
BODY_LIMIT=1mb
TRUST_PROXY=false

# ---------- Database ----------
# Local MongoDB (inspect with MongoDB Compass). Transactions need a replica set.
MONGODB_URI=mongodb://localhost:27017/meat_shop
MONGODB_AUTO_INDEX=true
MONGODB_MAX_POOL_SIZE=20
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-random-string-of-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---------- Rate limiting ----------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# ---------- SMTP Mail ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mvp.bose2352@gmail.com
SMTP_PASS=nvdi gggi ghqb rpmk
MAIL_FROM=NovaShop <mvp.bose2352@gmail.com>

# ---------- Swagger ----------
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
# Writes server/swagger.json on boot (used by the frontends' `npm run gen:api`)
SWAGGER_WRITE_FILE=true

# ---------- Logging ----------
LOG_LEVEL=info
LOG_PRETTY=true

# ---------- Business defaults ----------
DEFAULT_COMMISSION_BPS=1000
STOCK_RESERVATION_TTL_MINUTES=15
DELIVERY_SLOT_MINUTES=30
DEFAULT_SLOT_CAPACITY=10
WEIGHT_VARIANCE_PERCENT=10
