{
  "name": "meat-shop-server",
  "version": "0.1.0",
  "private": true,
  "description": "Tamil Nadu multi-vendor meat marketplace API",
  "type": "module",
  "engines": {
    "node": ">=20.19.4",
    "npm": ">=11.21.1"
  },
  "imports": {
    "#bootstrap": {
      "source": "./src/bootstrap/index.ts",
      "default": "./dist/bootstrap/index.js"
    },
    "#config": {
      "source": "./src/config/index.ts",
      "default": "./dist/config/index.js"
    },
    "#database": {
      "source": "./src/database/index.ts",
      "default": "./dist/database/index.js"
    },
    "#common/*": {
      "source": "./src/common/*/index.ts",
      "default": "./dist/common/*/index.js"
    },
    "#infra/*": {
      "source": "./src/infra/*/index.ts",
      "default": "./dist/infra/*/index.js"
    },
    "#modules/*": {
      "source": "./src/modules/*/index.ts",
      "default": "./dist/modules/*/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "start:dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --enable-source-maps dist/main.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config test/vitest.e2e.config.ts",
    "seed": "npm run build && node --enable-source-maps dist/database/seeds/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.3",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "dayjs": "^1.11.23",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.3",
    "nodemailer": "^6.10.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^12.2.0",
    "@swc/core": "^1.16.20",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "supertest": "^7.3.1",
    "tsc-watch": "^7.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "@swc/core@1.16.20": true,
    "@scarf/scarf": false
  }
}
